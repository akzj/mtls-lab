    {
      "mode": "managed",
      "type": "vault_policy",
      "name": "dev",
      "provider": "provider[\"registry.terraform.io/hashicorp/vault\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "id": "dev-policy",
            "name": "dev-policy",
            "namespace": null,
            "policy": "# Dev - read-only dev namespace\npath \"kv/data/dev/*\" {\n  capabilities = [\"read\", \"list\"]\n}\npath \"kv/metadata/dev/*\" {\n  capabilities = [\"read\", \"list\"]\n}\n"
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "bnVsbA=="
        }
      ]
    },
    {
      "mode": "managed",
      "type": "vault_policy",
      "name": "ops",
      "provider": "provider[\"registry.terraform.io/hashicorp/vault\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "id": "ops-policy",
            "name": "ops-policy",
            "namespace": null,
            "policy": "# Ops - read production/staging secrets, issue certificates\npath \"kv/data/production/*\" {\n  capabilities = [\"read\", \"list\"]\n}\npath \"kv/metadata/production/*\" {\n  capabilities = [\"read\", \"list\"]\n}\npath \"kv/data/staging/*\" {\n  capabilities = [\"read\", \"list\", \"create\", \"update\"]\n}\npath \"kv/metadata/staging/*\" {\n  capabilities = [\"read\", \"list\"]\n}\npath \"kv/data/dev/*\" {\n  capabilities = [\"read\", \"list\", \"create\", \"update\"]\n}\npath \"kv/metadata/dev/*\" {\n  capabilities = [\"read\", \"list\"]\n}\npath \"pki/issue/*\" {\n  capabilities = [\"create\", \"update\"]\n}\n"
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "bnVsbA=="
        }
      ]
    },
    {
      "mode": "managed",
      "type": "vault_policy",
      "name": "server",
      "provider": "provider[\"registry.terraform.io/hashicorp/vault\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "id": "server-policy",
            "name": "server-policy",
            "namespace": null,
            "policy": "path \"kv/data/server-config\" {\n  capabilities = [\"read\"]\n}\n\npath \"pki/issue/server\" {\n  capabilities = [\"create\", \"update\"]\n}\n\npath \"ssh/sign/sign-ssh\" {\n  capabilities = [\"create\", \"update\"]\n}\n\npath \"ssh-dc2/sign/sign-ssh\" {\n  capabilities = [\"create\", \"update\"]\n}\n\npath \"ssh/config/ca\" {\n  capabilities = [\"read\"]\n}\n\npath \"ssh-dc2/config/ca\" {\n  capabilities = [\"read\"]\n}\n"
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "bnVsbA=="
        }
      ]
