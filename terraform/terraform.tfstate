      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "id": "admin-policy",
            "name": "admin-policy",
            "namespace": null,
            "policy": "# Admin - full access to everything\npath \"*\" {\n  capabilities = [\"create\", \"read\", \"update\", \"delete\", \"list\", \"sudo\"]\n}\n"
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "bnVsbA=="
