            "policy": "# Dev - read-only dev namespace\npath \"kv/data/dev/*\" {\n  capabilities = [\"read\", \"list\"]\n}\npath \"kv/metadata/dev/*\" {\n  capabilities = [\"read\", \"list\"]\n}\n"
